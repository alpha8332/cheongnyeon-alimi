# Copy to .env.production (ignored by Git) and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=cheongnyeon-alimi-production

# Release images MUST be immutable digest references from production-release.json.
BACKEND_IMAGE=ghcr.io/CHANGE_ME/cheongnyeon-alimi-backend@sha256:CHANGE_ME
FRONTEND_IMAGE=ghcr.io/CHANGE_ME/cheongnyeon-alimi-frontend@sha256:CHANGE_ME

# Absolute host directory containing a verified manifest.json and dataset artifact.
PUBLIC_DATASET_DIR=C:/CHANGE_ME/public-bootstrap-version
NGINX_HOST_PORT=8080

POSTGRES_DB=cheongnyeon_alimi
POSTGRES_USER=cheongnyeon
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS
BACKEND_SECRET_KEY=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
ADMIN_PIN_HASH=CHANGE_ME_SHA256_OF_4_DIGIT_PIN
ADMIN_TOKEN_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS

# Same-origin access is served by Nginx. Add only real public origins if needed.
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]

# Central collector credentials are optional for public read-only deployments.
YOUTHCENTER_API_KEY=
BOKJIRO_API_KEY=
COLLECTION_WORKER_CONCURRENCY=2
COLLECTION_TASK_MAX_RETRIES=5
COLLECTION_TASK_RETRY_BACKOFF_MAX_SECONDS=300
COLLECTION_TASK_RATE_LIMIT=6/m
COLLECTION_SCHEDULE_ENABLED=false
COLLECTION_SCHEDULE_SOURCE_ID=youthcenter-api
COLLECTION_SCHEDULE_REQUESTED_COUNT=100
COLLECTION_SCHEDULE_COMPLETE_SNAPSHOT=false
COLLECTION_SNAPSHOT_REQUEST_BUDGET=12
COLLECTION_SCHEDULE_CRON_HOUR=3
COLLECTION_SCHEDULE_CRON_MINUTE=0
