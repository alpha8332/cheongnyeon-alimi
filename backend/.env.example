# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
APP_NAME=cheongnyeon-alimi-backend
SECRET_KEY=dev-secret-key-change-in-production

# Admin Access Control (Backend 04)
# ADMIN_PIN_HASH: SHA-256 hash of admin 4-digit PIN (Required in production, defaults to '0000' hash in dev)
# ADMIN_PIN_HASH=9af15b336e6a9619928537df30b2e6a2376569fcf9d7e773eccede65606529a0
# ADMIN_TOKEN_SECRET: Dedicated HMAC signing secret for admin session tokens (Falls back to SECRET_KEY if unset)
# ADMIN_TOKEN_SECRET=dev-admin-token-secret-change-in-production
# ADMIN_SESSION_EXPIRE_MINUTES=60

# Database
# Example credentials only. Replace them locally and never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cheongnyeon_alimi
# Optional: explicit _test database used by PostgreSQL integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cheongnyeon_alimi_test
# Optional: statement-only SQL diagnostics. Bound parameter values stay hidden.
SQL_ECHO=false

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
