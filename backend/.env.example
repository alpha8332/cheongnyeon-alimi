# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
APP_NAME=cheongnyeon-alimi-backend
SECRET_KEY=dev-secret-key-change-in-production

# Database
# Example credentials only. Replace them locally and never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cheongnyeon_alimi
# Optional: explicit _test database used by PostgreSQL integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cheongnyeon_alimi_test

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
