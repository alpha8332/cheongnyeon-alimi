# Copy to .env.compose (ignored by Git) and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=cheongnyeon-alimi-acceptance
ACCEPTANCE_IMAGE_TAG=local

# Generate URL-safe values, for example:
# [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
POSTGRES_DB=cheongnyeon_alimi_acceptance
POSTGRES_USER=cheongnyeon_acceptance
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS

TEST_POSTGRES_DB=cheongnyeon_alimi_acceptance_test
TEST_POSTGRES_USER=cheongnyeon_acceptance_test
TEST_POSTGRES_PASSWORD=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS

BACKEND_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
ADMIN_PIN_HASH=CHANGE_ME_SHA256_OF_4_DIGIT_PIN
ADMIN_TOKEN_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS

BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
POSTGRES_DEV_HOST_PORT=55432
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCK=false
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# restore.ps1 verifies the actual external snapshot and overrides these values
# only for the restore process. Keep non-secret placeholders so `compose config`
# can validate the full service graph without storing the real snapshot path.
ACCEPTANCE_SNAPSHOT_DIR=C:/CHANGE_ME/acceptance-snapshot
ACCEPTANCE_DUMP_FILENAME=acceptance-post-admission.dump
ACCEPTANCE_DUMP_SHA256=CHANGE_ME_64_HEX_CHARACTERS
ACCEPTANCE_ALEMBIC_REVISION=20260810_0006
