# Global Environment Variables for Docker Compose

# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cheongnyeon_alimi
POSTGRES_PORT=5432

# Backend Service Settings
DATABASE_URL=postgresql://postgres:postgres@database:5432/cheongnyeon_alimi
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Settings
FRONTEND_PORT=3000
