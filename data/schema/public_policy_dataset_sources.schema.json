{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cheongnyeon-alimi:schema:public-policy-dataset-sources:1.1.0",
  "title": "PublicPolicyDatasetSources",
  "description": "Default-deny source and field contract for public normalized policy datasets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "checked_at",
    "default_decision",
    "normalized_program",
    "content_rules",
    "included_sources",
    "known_exclusions"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1.0"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "default_decision": {
      "const": "exclude"
    },
    "normalized_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_path",
        "allowed_fields",
        "forbidden_database_fields"
      ],
      "properties": {
        "schema_version": {
          "const": "1.2.0"
        },
        "schema_path": {
          "const": "data/schema/normalized_program.schema.json"
        },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "forbidden_database_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "id",
              "created_at",
              "updated_at"
            ]
          }
        }
      }
    },
    "content_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_raw_payload",
        "include_database_dump",
        "allow_institutional_contacts",
        "unsafe_record_action",
        "reject_email",
        "reject_personal_mobile",
        "forbidden_query_keys"
      ],
      "properties": {
        "include_raw_payload": {
          "const": false
        },
        "include_database_dump": {
          "const": false
        },
        "allow_institutional_contacts": {
          "const": false
        },
        "unsafe_record_action": {
          "const": "exclude"
        },
        "reject_email": {
          "const": true
        },
        "reject_personal_mobile": {
          "const": true
        },
        "forbidden_query_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      }
    },
    "included_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/includedSource"
      }
    },
    "known_exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "$defs": {
    "includedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "decision",
        "provider",
        "dataset_name",
        "license_name",
        "license_url",
        "evidence_checked_at",
        "attribution"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "decision": {
          "const": "include"
        },
        "provider": {
          "$ref": "#/$defs/nonemptyText"
        },
        "dataset_name": {
          "$ref": "#/$defs/nonemptyText"
        },
        "license_name": {
          "$ref": "#/$defs/nonemptyText"
        },
        "license_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "evidence_checked_at": {
          "type": "string",
          "format": "date"
        },
        "attribution": {
          "$ref": "#/$defs/nonemptyText"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "value",
        "reason_code",
        "evidence_reference",
        "evidence_checked_at"
      ],
      "properties": {
        "selector": {
          "type": "string",
          "enum": [
            "source_id",
            "source_prefix"
          ]
        },
        "value": {
          "$ref": "#/$defs/nonemptyText"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "terms_restrict_redistribution",
            "no_explicit_open_license",
            "item_level_license_unverified"
          ]
        },
        "evidence_reference": {
          "type": "string",
          "pattern": "^(?:https://|data/reference/).+"
        },
        "evidence_checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}
