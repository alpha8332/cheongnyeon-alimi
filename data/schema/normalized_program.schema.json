{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cheongnyeon-alimi:schema:normalized-program:1.2.0",
  "title": "NormalizedProgram",
  "description": "Canonical policy data with quality status and Raw provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_name",
    "external_id",
    "title",
    "organization",
    "summary",
    "category_text",
    "categories",
    "keywords",
    "life_stages",
    "target_groups",
    "application_period_text",
    "application_start",
    "application_end",
    "application_schedule",
    "application_status",
    "region_text",
    "regions",
    "coverage_scope",
    "region_rules",
    "age_min",
    "age_max",
    "age_condition_text",
    "eligibility_text",
    "eligibility_summary",
    "support_content",
    "application_method",
    "education_statuses",
    "employment_statuses",
    "required_conditions",
    "preferred_conditions",
    "excluded_conditions",
    "source_url",
    "collected_at",
    "provenance",
    "data_quality_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "organization": {
      "$ref": "#/$defs/nullableText"
    },
    "summary": {
      "$ref": "#/$defs/nullableText"
    },
    "category_text": {
      "$ref": "#/$defs/nullableText"
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "housing",
          "finance",
          "welfare",
          "employment",
          "startup",
          "education",
          "other"
        ]
      }
    },
    "keywords": {
      "$ref": "#/$defs/stringArray"
    },
    "life_stages": {
      "$ref": "#/$defs/stringArray"
    },
    "target_groups": {
      "$ref": "#/$defs/stringArray"
    },
    "application_period_text": {
      "$ref": "#/$defs/nullableText"
    },
    "application_start": {
      "$ref": "#/$defs/nullableDate"
    },
    "application_end": {
      "$ref": "#/$defs/nullableDate"
    },
    "application_schedule": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed_period",
        "always",
        "until_budget_exhausted",
        null
      ]
    },
    "application_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "open",
        "closed",
        "scheduled",
        null
      ]
    },
    "region_text": {
      "$ref": "#/$defs/nullableText"
    },
    "regions": {
      "$ref": "#/$defs/stringArray"
    },
    "coverage_scope": {
      "type": "string",
      "enum": [
        "nationwide",
        "regional",
        "unknown"
      ]
    },
    "region_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/regionRule"
      }
    },
    "age_min": {
      "$ref": "#/$defs/nullableAge"
    },
    "age_max": {
      "$ref": "#/$defs/nullableAge"
    },
    "age_condition_text": {
      "$ref": "#/$defs/nullableText"
    },
    "eligibility_text": {
      "$ref": "#/$defs/nullableText"
    },
    "eligibility_summary": {
      "$ref": "#/$defs/eligibilitySummary"
    },
    "support_content": {
      "$ref": "#/$defs/nullableText"
    },
    "application_method": {
      "$ref": "#/$defs/nullableText"
    },
    "education_statuses": {
      "$ref": "#/$defs/stringArray"
    },
    "employment_statuses": {
      "$ref": "#/$defs/stringArray"
    },
    "required_conditions": {
      "$ref": "#/$defs/stringArray"
    },
    "preferred_conditions": {
      "$ref": "#/$defs/stringArray"
    },
    "excluded_conditions": {
      "$ref": "#/$defs/stringArray"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?![^/?#]*@)[^\\s]+$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "data_quality_status": {
      "type": "string",
      "enum": [
        "valid",
        "partial",
        "invalid"
      ]
    }
  },
  "$defs": {
    "eligibilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "requirements",
        "exclusions",
        "preferences",
        "documents",
        "unknowns",
        "institutional_contacts"
      ],
      "properties": {
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "requirements": {
          "$ref": "#/$defs/eligibilityItems"
        },
        "exclusions": {
          "$ref": "#/$defs/eligibilityItems"
        },
        "preferences": {
          "$ref": "#/$defs/eligibilityItems"
        },
        "documents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requiredDocument"
          }
        },
        "unknowns": {
          "$ref": "#/$defs/eligibilityItems"
        },
        "institutional_contacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/institutionalContact"
          }
        }
      }
    },
    "eligibilityItems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eligibilityItem"
      }
    },
    "eligibilityItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "text",
        "evidence"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "age",
            "region",
            "income",
            "asset",
            "employment",
            "education",
            "housing",
            "household",
            "other"
          ]
        },
        "text": {
          "$ref": "#/$defs/eligibilitySourceText"
        },
        "evidence": {
          "$ref": "#/$defs/eligibilityEvidenceArray"
        }
      }
    },
    "requiredDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/eligibilityDocumentText"
        },
        "evidence": {
          "$ref": "#/$defs/eligibilityEvidenceArray"
        }
      }
    },
    "institutionalContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "value",
        "evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "phone",
            "official_channel"
          ]
        },
        "label": {
          "$ref": "#/$defs/eligibilityContactLabel"
        },
        "value": {
          "$ref": "#/$defs/eligibilityContactValue"
        },
        "evidence": {
          "$ref": "#/$defs/eligibilityEvidenceArray"
        }
      }
    },
    "eligibilityEvidenceArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eligibilityEvidence"
      }
    },
    "eligibilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_url",
        "collected_at",
        "locator_type",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://(?![^/?#]*@)[^\\s]+$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "locator_type": {
          "type": "string",
          "enum": [
            "source_field",
            "css_selector"
          ]
        },
        "locator": {
          "$ref": "#/$defs/eligibilityLocatorText"
        }
      }
    },
    "eligibilitySourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "eligibilityDocumentText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "eligibilityContactLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "eligibilityContactValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!.*@)(?!.*(?:^|\\D)(?:\\+?82[- .]?)?0?1(?:0|1|6|7|8|9)[- .]?\\d{3,4}[- .]?\\d{4}(?:\\D|$))\\S(?:.*\\S)?$"
    },
    "eligibilityLocatorText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "nullableAge": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 150
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "regionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "resolution_status",
        "region_scheme",
        "region_code",
        "source_code",
        "source_text"
      ],
      "properties": {
        "relation": {
          "type": "string",
          "enum": [
            "include",
            "exclude"
          ]
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "matched",
            "unmapped",
            "ambiguous"
          ]
        },
        "region_scheme": {
          "$ref": "#/$defs/nullableText"
        },
        "region_code": {
          "$ref": "#/$defs/nullableText"
        },
        "source_code": {
          "$ref": "#/$defs/nullableText"
        },
        "source_text": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_document_id",
        "document_role",
        "content_hash",
        "collected_at",
        "source_url"
      ],
      "properties": {
        "raw_document_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "document_role": {
          "type": "string",
          "enum": [
            "list_response",
            "list_item",
            "detail_response"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^\\s?#]+$"
        }
      }
    }
  }
}
