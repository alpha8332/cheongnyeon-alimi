{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cheongnyeon-alimi:schema:public-policy-dataset-pointer:1.0.0",
  "title": "PublicPolicyDatasetPointer",
  "description": "Small mutable pointer to an immutable public dataset manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pointer_version",
    "dataset_version",
    "manifest_url",
    "manifest_sha256",
    "updated_at"
  ],
  "properties": {
    "pointer_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^public-bootstrap-[0-9]{8}-[0-9a-f]{7,40}$"
    },
    "manifest_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
