{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cheongnyeon-alimi:schema:public-policy-dataset-manifest:1.0.0",
  "title": "PublicPolicyDatasetManifest",
  "description": "Integrity and license manifest for a public normalized bootstrap dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_version",
    "generated_at",
    "git_sha",
    "previous_dataset_version",
    "normalized_schema",
    "source_contract",
    "artifact",
    "sources",
    "selection",
    "content_safety",
    "distribution_notice"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^public-bootstrap-[0-9]{8}-[0-9a-f]{7,40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "previous_dataset_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^public-bootstrap-[0-9]{8}-[0-9a-f]{7,40}$"
    },
    "normalized_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "1.2.0"
        },
        "path": {
          "const": "data/schema/normalized_program.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "path": {
          "const": "data/reference/public_policy_dataset_sources.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "bytes",
        "row_count"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^cheongnyeon-alimi-public-bootstrap-[0-9]{8}-[0-9a-f]{7,40}\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "row_count",
          "license_name",
          "license_url",
          "attribution"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "row_count": {
            "type": "integer",
            "minimum": 1
          },
          "license_name": {
            "$ref": "#/$defs/nonemptyText"
          },
          "license_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "attribution": {
            "$ref": "#/$defs/nonemptyText"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_row_count",
        "published_row_count",
        "excluded_row_count",
        "excluded_reason_row_counts"
      ],
      "properties": {
        "candidate_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "published_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "excluded_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_reason_row_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "institutional_contact",
            "email",
            "personal_mobile",
            "forbidden_query_key"
          ],
          "properties": {
            "institutional_contact": {
              "type": "integer",
              "minimum": 0
            },
            "email": {
              "type": "integer",
              "minimum": 0
            },
            "personal_mobile": {
              "type": "integer",
              "minimum": 0
            },
            "forbidden_query_key": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "content_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_included",
        "database_dump_included",
        "institutional_contact_count",
        "email_match_count",
        "personal_mobile_match_count",
        "forbidden_query_key_match_count"
      ],
      "properties": {
        "raw_payload_included": {
          "const": false
        },
        "database_dump_included": {
          "const": false
        },
        "institutional_contact_count": {
          "const": 0
        },
        "email_match_count": {
          "const": 0
        },
        "personal_mobile_match_count": {
          "const": 0
        },
        "forbidden_query_key_match_count": {
          "const": 0
        }
      }
    },
    "distribution_notice": {
      "$ref": "#/$defs/nonemptyText"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonemptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}
